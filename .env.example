# Store Intelligence System — Environment Configuration
# Copy this file to .env and edit as needed

# ─── Video Source ─────────────────────────────────────────────
# "demo"      → synthetic demo mode (no camera needed, recommended for dev)
# "0"         → webcam (device index)
# "/path/to/video.mp4" → pre-recorded video file
# "rtsp://..."         → RTSP camera stream
VIDEO_SOURCE=demo

# ─── YOLO Model ───────────────────────────────────────────────
# yolov8n.pt  → Nano   (fastest, ~6 MB, auto-downloads)
# yolov8s.pt  → Small  (better accuracy, ~22 MB)
# yolov8m.pt  → Medium (best accuracy, ~50 MB)
YOLO_MODEL=yolov8n.pt
YOLO_CONF_THRESHOLD=0.40
FRAME_SKIP=2

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./store_intelligence.db

# ─── Anomaly Detection ────────────────────────────────────────
CROWD_THRESHOLD=5
DWELL_THRESHOLD_SECONDS=30
ANOMALY_ZSCORE_THRESHOLD=2.5

# ─── Store Hours (24-hour, IST) ───────────────────────────────
STORE_OPEN_HOUR=9
STORE_CLOSE_HOUR=21

# ─── Camera Info ──────────────────────────────────────────────
CAMERA_ID=cam_01
CAMERA_NAME=Main Store Camera

# ─── Debug ────────────────────────────────────────────────────
DEBUG=false
